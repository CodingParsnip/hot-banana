[connection signal="pressed" from="Menu/VBoxContainer/ResumeButton" to="." method="_on_resume_button_pressed"]
[connection signal="pressed" from="Menu/VBoxContainer/RestartButton" to="." method="_on_restart_button_pressed"]
[connection signal="pressed" from="Menu/VBoxContainer/MenuButton" to="." method="_on_menu_button_pressed"]
[connection signal="timeout" from="ResumeTimer" to="." method="_on_resume_timer_timeout"]
